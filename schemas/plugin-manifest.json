{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flipctl.dev/schemas/plugin-manifest.json",
  "title": "FlipCTL plugin manifest",
  "description": "Declarative app manifest accepted from plugin directories and from the runtime registration API. Both paths validate against this schema before semantic checks in internal/plugin.Validate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "flipctl.app/v1alpha1"},
    "kind": {"enum": ["CommandApp", "ViewApp"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {"type": "string", "maxLength": 280},
        "category": {"type": "string", "maxLength": 40},
        "version": {"type": "string", "maxLength": 40}
      }
    },
    "form": {"$ref": "#/$defs/fields"},
    "execution": {"$ref": "#/$defs/command"},
    "parser": {"type": "string", "maxLength": 40},
    "policy": {"type": "object"},
    "availability": {"type": "object", "additionalProperties": {"type": "string"}},
    "owner": {
      "description": "The app and conversation that registered this app at runtime. Used to group archived registrations for restore.",
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin"],
      "properties": {
        "plugin": {"$ref": "#/$defs/id"},
        "conversation": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,64}$"}
      }
    },
    "capabilities": {
      "description": "Host effects the app needs. Declaring any of them makes a runtime registration pending until it is confirmed on the device.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {"type": "boolean"},
        "devices": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/dev/[A-Za-z0-9._/-]+$"}
        },
        "rf_transmit": {"type": "boolean"}
      }
    },
    "actions": {
      "description": "ViewApp buttons. Each binds exactly one of run (start a registered CommandApp), ask, revise or act (send the view's state to the assistant provider).",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string", "minLength": 1, "maxLength": 60},
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plugin"],
            "properties": {
              "plugin": {"$ref": "#/$defs/id"},
              "args": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 256}}
            }
          },
          "ask": {"$ref": "#/$defs/prompt"},
          "revise": {"$ref": "#/$defs/prompt"},
          "act": {"$ref": "#/$defs/prompt"}
        },
        "oneOf": [{"required": ["run"]}, {"required": ["ask"]}, {"required": ["revise"]}, {"required": ["act"]}]
      }
    },
    "display": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "as"],
        "properties": {
          "from": {"enum": ["lastJob"]},
          "as": {"enum": ["table", "log"]},
          "title": {"type": "string", "maxLength": 80},
          "columns": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/id"}},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    },
    "id": {"$ref": "#/$defs/id", "deprecated": true},
    "title": {"type": "string", "deprecated": true},
    "summary": {"type": "string", "deprecated": true},
    "category": {"type": "string", "deprecated": true},
    "version": {"type": "string", "deprecated": true},
    "fields": {"$ref": "#/$defs/fields", "deprecated": true},
    "command": {"$ref": "#/$defs/command", "deprecated": true}
  },
  "anyOf": [{"required": ["metadata"]}, {"required": ["id"]}],
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "ViewApp"}}, "required": ["kind"]},
      "then": {"required": ["actions"], "not": {"anyOf": [{"required": ["execution"]}, {"required": ["command"]}]}},
      "else": {"not": {"anyOf": [{"required": ["actions"]}, {"required": ["display"]}]}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$", "minLength": 1, "maxLength": 96},
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string", "maxLength": 80},
          "type": {"enum": ["string", "int"]},
          "default": {"type": "string"},
          "required": {"type": "boolean"},
          "pattern": {"type": "string", "maxLength": 256},
          "min": {"type": "integer"},
          "max": {"type": "integer"}
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
        "context": {"type": "array", "uniqueItems": true, "items": {"enum": ["form", "lastJob", "view"]}}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "args": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "timeoutSeconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "parser": {"type": "string", "maxLength": 40}
      }
    }
  }
}
